    {
      "id": 26,
      "type": "table",
      "title": "Pods not ready",
      "description": "Pending, Running or Unknown pods whose Ready condition is false (completed pods excluded).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "${prometheus_datasource_type}",
