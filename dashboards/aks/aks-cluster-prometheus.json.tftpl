          "url": "/d/fd0cac08a3f34e2994cf904627836738?var-datasource=$ds&var-cluster=$cluster&$${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Running pods",
      "description": "Pods in phase Running in the selected namespaces.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "datasource": {
        "type": "${prometheus_datasource_type}",
        "uid": "$ds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "sum(kube_pod_status_phase{cluster=\"$cluster\", namespace=~\"$namespace\", phase=\"Running\"})",
