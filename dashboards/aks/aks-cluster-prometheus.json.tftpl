    {
      "id": 29,
      "type": "table",
      "title": "OOMKilled containers",
      "description": "Containers whose last termination reason is OOMKilled, with their restarts in the selected time range.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "datasource": {
        "type": "${prometheus_datasource_type}",
        "uid": "$ds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "sum by (namespace, pod, container) (round(increase(kube_pod_container_status_restarts_total{cluster=\"$cluster\", namespace=~\"$namespace\"}[$__range]))) * on (namespace, pod, container) group_left() (sum by (namespace, pod, container) (kube_pod_container_status_last_terminated_reason{cluster=\"$cluster\", namespace=~\"$namespace\", reason=\"OOMKilled\"}) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
