    {
      "id": 11,
      "type": "stat",
      "title": "Failed pods",
      "description": "Pods in phase Failed that still exist in the API.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "${prometheus_datasource_type}",
        "uid": "$ds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
