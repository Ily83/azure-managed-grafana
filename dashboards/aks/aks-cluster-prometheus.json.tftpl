    {
      "id": 18,
      "type": "timeseries",
      "title": "CPU: usage vs requests vs allocatable",
      "description": "CPU cores: container usage (cAdvisor), requests of Pending/Running pods, node allocatable.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "${prometheus_datasource_type}",
        "uid": "$ds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{cluster=\"$cluster\", container!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "usage",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "sum(sum by (namespace, pod, cluster) (max by (namespace, pod, container, cluster) (kube_pod_container_resource_requests{resource=\"cpu\", cluster=\"$cluster\"}) * on (namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (kube_pod_status_phase{phase=~\"Pending|Running\", cluster=\"$cluster\"} == 1)))",
          "legendFormat": "requests",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "sum(kube_node_status_allocatable{resource=\"cpu\", cluster=\"$cluster\"})",
          "legendFormat": "allocatable",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Open Kubernetes / Compute Resources / Cluster",
          "url": "/d/fd0cac08a3f34e2994cf904627836738?var-datasource=$ds&var-cluster=$cluster&$${__url_time_range}",
