          "targetBlank": false
        }
      ]
    },
    {
      "id": 27,
      "type": "table",
      "title": "Containers waiting",
      "description": "Containers in a waiting state, by reason (CrashLoopBackOff, ImagePullBackOff, ...).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": {
        "type": "${prometheus_datasource_type}",
        "uid": "$ds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "sum by (namespace, pod, container, reason) (kube_pod_container_status_waiting_reason{cluster=\"$cluster\", namespace=~\"$namespace\"}) > 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
