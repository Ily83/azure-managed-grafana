      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "sum by (namespace, pod) (kube_pod_status_ready{cluster=\"$cluster\", namespace=~\"$namespace\", condition=\"false\"} * on (cluster, namespace, pod) group_left() max by (cluster, namespace, pod) (kube_pod_status_phase{cluster=\"$cluster\", namespace=~\"$namespace\", phase=~\"Pending|Running|Unknown\"} == 1)) > 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "not ready",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "not ready"
            }
          }
        }
      ],
      "links": [
        {
          "title": "Open Kubernetes / Compute Resources / Pod",
