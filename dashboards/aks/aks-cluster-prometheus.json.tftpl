        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "restarts in range",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "restarts in range"
            }
          }
        }
      ]
