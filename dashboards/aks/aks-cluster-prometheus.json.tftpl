      "id": 31,
      "type": "bargauge",
      "title": "PVC usage (top 15)",
      "description": "kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes per PersistentVolumeClaim.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 62
      },
      "datasource": {
        "type": "${prometheus_datasource_type}",
        "uid": "$ds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "${prometheus_datasource_type}",
            "uid": "$ds"
          },
          "expr": "topk(15, max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{cluster=\"$cluster\", namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{cluster=\"$cluster\", namespace=~\"$namespace\"}))",
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "links": []
    },
