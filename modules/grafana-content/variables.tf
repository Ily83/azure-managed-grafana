variable "dashboard_commit_message" {
  type        = string
  default     = "Managed by Terraform"
  description = "The commit message stored in the Grafana dashboard version history on every change."
  nullable    = false
}

variable "dashboard_overwrite" {
  type        = bool
  default     = true
  description = "Overwrite dashboards that already exist with the same UID (e.g. created by hand before Terraform took over). Defaults to `true`."
  nullable    = false
}

variable "dashboard_template_variables" {
  type        = map(string)
  default     = {}
  description = <<DESCRIPTION
Variables passed to `templatefile()` for `*.json.tftpl` dashboards, typically data source UIDs and resource IDs
that differ per environment. Plain `*.json` files are uploaded as-is.

Inside a `.tftpl` file, Grafana's own `$${var}` syntax must be escaped as `$$${var}`. `$var` and `$__interval` need no escaping.
DESCRIPTION
  nullable    = false
}

variable "dashboards_directory" {
  type        = string
  default     = null
  description = <<DESCRIPTION
Path to a directory of dashboard JSON files laid out as `<folder key>/<dashboard>.json` or `<folder key>/<dashboard>.json.tftpl`.
Each sub-directory becomes a Grafana folder (its title defaults to the directory name; override it in `folders`).
DESCRIPTION
}

variable "data_source_secure_json_data" {
  type        = map(map(string))
  default     = {}
  description = "Secret settings (passwords, tokens, client secrets) per data source, keyed like `data_sources`. Not needed for data sources that use the Grafana managed identity."
  nullable    = false
  sensitive   = true
}

variable "data_sources" {
  type = map(object({
    name              = string
    type              = string
    uid               = optional(string, null)
    url               = optional(string, null)
    access_mode       = optional(string, "proxy")
    is_default        = optional(bool, false)
    json_data_encoded = optional(string, null)
  }))
  default     = {}
  description = <<DESCRIPTION
A map of Grafana data sources to create. Set an explicit `uid` so dashboards can reference the data source in every environment.

- `name` - The display name of the data source.
- `type` - The plugin type, e.g. `prometheus`, `grafana-azure-monitor-datasource`, `grafana-azure-data-explorer-datasource`.
- `uid` - (Optional) A stable unique identifier. Generated by Grafana when omitted.
- `url` - (Optional) The URL of the data source, e.g. the query endpoint of an Azure Monitor workspace.
- `access_mode` - (Optional) `proxy` or `direct`. Defaults to `proxy`.
- `is_default` - (Optional) Make this the default data source. Defaults to `false`.
- `json_data_encoded` - (Optional) Plugin settings as a JSON string, e.g. `jsonencode({ azureCredentials = { authType = "msi" } })`.
DESCRIPTION
  nullable    = false

  validation {
    condition     = alltrue([for v in var.data_sources : contains(["proxy", "direct"], v.access_mode)])
    error_message = "`access_mode` must be `proxy` or `direct`."
  }
}

variable "folders" {
  type = map(object({
    title = string
    uid   = optional(string, null)
    permissions = optional(list(object({
      permission = string
      role       = optional(string, null)
      team_id    = optional(string, null)
      user_id    = optional(string, null)
    })), null)
    prevent_destroy_if_not_empty = optional(bool, true)
  }))
  default     = {}
  description = <<DESCRIPTION
A map of Grafana folders to create, keyed by folder key (the dashboard sub-directory name). Folders found in `dashboards_directory`
are created automatically; add them here only to change their title or UID or to manage their permissions.

- `title` - The folder title.
- `uid` - (Optional) A stable unique identifier. Defaults to the map key.
- `permissions` - (Optional) The complete list of folder permissions. `null` leaves permissions unmanaged; a list replaces all existing permissions.
  - `permission` - `View`, `Edit` or `Admin`.
  - `role` - (Optional) `Viewer` or `Editor`.
  - `team_id` - (Optional) A Grafana team ID.
  - `user_id` - (Optional) A Grafana user ID.
- `prevent_destroy_if_not_empty` - (Optional) Refuse to delete the folder while it still holds dashboards or alert rules created outside Terraform. Defaults to `true`.
DESCRIPTION
  nullable    = false

  validation {
    condition = alltrue(flatten([
      for f in var.folders : [
        for p in coalesce(f.permissions, []) : contains(["View", "Edit", "Admin"], p.permission) && length(compact([p.role, p.team_id, p.user_id])) == 1
      ]
    ]))
    error_message = "Each folder permission needs `permission` set to View, Edit or Admin, and exactly one of `role`, `team_id` or `user_id`."
  }
  validation {
    condition     = alltrue([for f in var.folders : f.uid == null || can(regex("^[a-zA-Z0-9_-]{1,40}$", f.uid))])
    error_message = "Folder UIDs must be 1-40 characters of letters, digits, `-` and `_`."
  }
}
