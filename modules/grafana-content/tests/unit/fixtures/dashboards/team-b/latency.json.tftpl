{
  "uid": "team-b-latency",
  "title": "Latency",
  "schemaVersion": 41,
  "panels": [
    {
      "type": "timeseries",
      "title": "p95 latency",
      "datasource": { "type": "prometheus", "uid": "${prometheus_uid}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "$${instance}" }
      ]
    }
  ]
}
